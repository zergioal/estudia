# Base de datos (docker compose up -d db)
DATABASE_URL="postgresql://estudia:estudia@localhost:5432/estudia?schema=public"
DATABASE_URL_TEST="postgresql://estudia:estudia@localhost:5432/estudia_test?schema=public"

# API
PORT=3000
JWT_SECRET="cambia-esto-por-un-secreto-largo"
JWT_EXPIRA="7d"
CORS_ORIGEN="http://localhost:5173"

# Admin inicial (npm run db:seed)
ADMIN_USUARIO="admin"
ADMIN_PASSWORD="cambia-esta-clave"
ADMIN_NOMBRE="Administrador"

# Calidad (opcionales)
# MODELO_EMBEDDINGS="Xenova/multilingual-e5-small"   # local, 384 dim; se descarga a storage/modelos
# UMBRAL_DUPLICADO=0.97                               # coseno para marcar DUPLICADA al importar
# ANTHROPIC_API_KEY=""                                # activa el validador "a ciegas" (tiene costo)
# MODELO_VALIDADOR="claude-opus-5-5"
