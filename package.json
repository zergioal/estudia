{
  "name": "estudia",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @estudia/api\" \"npm run dev -w @estudia/web\"",
    "test": "npm run test -w @estudia/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @estudia/api --",
    "db:seed": "npm run db:seed -w @estudia/api",
    "importar": "npm run importar -w @estudia/api --"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.0"
  }
}
