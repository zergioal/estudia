generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Rol {
  ADMIN
  REVISOR
  ESTUDIANTE
}

enum Dificultad {
  FACIL
  MEDIA
  DIFICIL
}

enum TipoPregunta {
  OPCION_MULTIPLE
  VERDADERO_FALSO
  SELECCION_MULTIPLE
  COMPLETAR
  ORDENAR
  CASO
}

enum EstadoPregunta {
  BORRADOR
  VALIDADA
  APROBADA
  DESCARTADA
  DUPLICADA
  EN_REVISION
}

enum ModoQuiz {
  PRACTICA
  EXAMEN
  REPASO_ERRORES
  SIMULACRO
  REPASO_DIARIO
}

model Usuario {
  id            String          @id @default(cuid())
  usuario       String          @unique
  nombre        String
  passwordHash  String
  rol           Rol             @default(ESTUDIANTE)
  xpTotal       Int             @default(0)
  rachaDias     Int             @default(0)
  ultimoEstudio DateTime?
  activo        Boolean         @default(true)
  intentos      Intento[]
  estados       EstadoEstudio[]
  asignaciones  Asignacion[]
  creadoEn      DateTime        @default(now())
}

model Coleccion {
  id           String       @id @default(cuid())
  nombre       String       @unique
  descripcion  String?
  contenidos   Contenido[]
  asignaciones Asignacion[]
  creadoEn     DateTime     @default(now())
}

model Contenido {
  id          String      @id @default(cuid())
  coleccionId String
  coleccion   Coleccion   @relation(fields: [coleccionId], references: [id])
  titulo      String      @unique
  clave       String?     @unique // prefijo de Fragmento.ref y carpeta en fuentes/, ej. "ley070"
  tipoFuente  String // LEY, DECRETO, RM, LIBRO, GUIA
  publicado   Boolean     @default(false)
  temas       Tema[]
  documentos  Documento[]
  guia        GuiaEstudio?
  creadoEn    DateTime    @default(now())

  @@index([coleccionId])
}

model Tema {
  id          String      @id @default(cuid())
  contenidoId String
  contenido   Contenido   @relation(fields: [contenidoId], references: [id])
  padreId     String?
  padre       Tema?       @relation("Jerarquia", fields: [padreId], references: [id])
  hijos       Tema[]      @relation("Jerarquia")
  nombre      String
  orden       Int         @default(0)
  fragmentos  Fragmento[]
  preguntas   Pregunta[]

  @@index([contenidoId, padreId])
}

model Documento {
  id            String      @id @default(cuid())
  contenidoId   String
  contenido     Contenido   @relation(fields: [contenidoId], references: [id])
  nombreArchivo String
  archivoUrl    String // ruta relativa dentro de STORAGE_DIR
  hash          String      @unique // evita subir el mismo PDF dos veces
  estado        String // SUBIDO, PROCESANDO, EXTRAIDO, FRAGMENTADO, ERROR
  error         String?
  paginas       Int?
  paginasOcr    Int         @default(0)
  modo          String? // NORMATIVA (por artículos) o LIBRO (por bloques)
  fragmentos    Fragmento[]
  textos        Pagina[]
  creadoEn      DateTime    @default(now())
  procesadoEn   DateTime?

  @@index([contenidoId])
}

/// Texto extraído de cada página; permite re-fragmentar sin repetir el OCR.
model Pagina {
  id          String    @id @default(cuid())
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  numero      Int
  texto       String
  ocr         Boolean   @default(false)
  confianza   Float?

  @@unique([documentoId, numero])
}

model Fragmento {
  id          String                       @id @default(cuid())
  ref         String?                      @unique // ej. "ley070-art05": coincide con fragmentoRef del JSON y con fuentes/<contenido>/<ref>.md
  documentoId String
  documento   Documento                    @relation(fields: [documentoId], references: [id])
  temaId      String?
  tema        Tema?                        @relation(fields: [temaId], references: [id])
  etiqueta    String // "Art. 5", "Cap. III"
  orden       Int                          @default(0)
  texto       String
  palabras    Int                          @default(0)
  paginaDesde Int
  paginaHasta Int
  embedding   Unsupported("vector(1024)")?
  preguntas   Pregunta[]

  @@index([documentoId, orden])
  @@index([temaId])
}

model Pregunta {
  id              String                       @id @default(cuid())
  temaId          String
  tema            Tema                         @relation(fields: [temaId], references: [id])
  fragmentoId     String?
  fragmento       Fragmento?                   @relation(fields: [fragmentoId], references: [id])
  fragmentoRef    String? // referencia del JSON aunque el fragmento aún no exista en la BD
  tipo            TipoPregunta
  dificultad      Dificultad
  nivelBloom      String
  enunciado       String
  explicacion     String
  citaTextual     String
  referencia      String
  etiquetas       String[]
  estado          EstadoPregunta               @default(BORRADOR)
  origen          String // CLAUDE_CODE, MCP, API, MANUAL
  trabajoId       String?
  vecesRespondida Int                          @default(0)
  vecesAcertada   Int                          @default(0)
  embedding       Unsupported("vector(1024)")?
  opciones        Opcion[]
  respuestas      Respuesta[]
  estados         EstadoEstudio[]
  creadoEn        DateTime                     @default(now())
  actualizadoEn   DateTime                     @updatedAt

  @@index([temaId, estado, dificultad])
  @@index([estado])
}

model Opcion {
  id         String   @id @default(cuid())
  preguntaId String
  pregunta   Pregunta @relation(fields: [preguntaId], references: [id], onDelete: Cascade)
  texto      String
  correcta   Boolean
  porQue     String?
  orden      Int

  @@index([preguntaId])
}

model Intento {
  id           String      @id @default(cuid())
  usuarioId    String
  usuario      Usuario     @relation(fields: [usuarioId], references: [id])
  modo         ModoQuiz
  filtros      Json // contenidos, temas, dificultad
  cantidad     Int
  puntaje      Int         @default(0)
  aciertos     Int         @default(0)
  iniciadoEn   DateTime    @default(now())
  finalizadoEn DateTime?
  respuestas   Respuesta[]

  @@index([usuarioId, iniciadoEn])
}

model Respuesta {
  id               String   @id @default(cuid())
  intentoId        String
  intento          Intento  @relation(fields: [intentoId], references: [id])
  preguntaId       String
  pregunta         Pregunta @relation(fields: [preguntaId], references: [id])
  orden            Int
  ordenOpciones    String[] // ids de Opcion en el orden barajado que vio el estudiante
  opcionesElegidas String[]
  correcta         Boolean?
  xp               Int      @default(0)
  segundos         Int?
  confianza        Int? // 1 = adiviné, 2 = dudé, 3 = seguro
  respondidaEn     DateTime?

  @@unique([intentoId, preguntaId])
}

model EstadoEstudio {
  usuarioId       String
  preguntaId      String
  usuario         Usuario   @relation(fields: [usuarioId], references: [id])
  pregunta        Pregunta  @relation(fields: [preguntaId], references: [id])
  aciertos        Int       @default(0)
  fallos          Int       @default(0)
  facilidad       Float     @default(2.5)
  intervaloDias   Int       @default(0)
  proximaRevision DateTime  @default(now())
  ultimaRespuesta DateTime?

  @@id([usuarioId, preguntaId])
  @@index([usuarioId, proximaRevision])
}

model Asignacion {
  id          String    @id @default(cuid())
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id])
  coleccionId String
  coleccion   Coleccion @relation(fields: [coleccionId], references: [id])
  venceEn     DateTime?
}

/// Guía de estudio de un documento: resumen, ideas clave y qué partes leer (obligatorio/opcional).
model GuiaEstudio {
  id            String    @id @default(cuid())
  contenidoId   String    @unique
  contenido     Contenido @relation(fields: [contenidoId], references: [id], onDelete: Cascade)
  resumen       String
  ideasClave    String[]
  obligatorio   Json // [{ parte, titulo, porQue }]
  opcional      Json // [{ parte, titulo, porQue }]
  consejos      String[]
  actualizadoEn DateTime  @updatedAt
}
